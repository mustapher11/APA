<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="20.0" style="-fx-background-color: linear-gradient(to right, #EE9CA7, #FFDDE1);" xmlns="http://javafx.com/javafx/18"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mia.apa.ResetPasswordController">
    <Label text="CASHIER SECTION" textAlignment="CENTER" textFill="#000000">
        <VBox.margin>
            <Insets top="20.0" />
        </VBox.margin>
        <font>
            <Font name="System Bold Italic" size="30.0" />
        </font>
    </Label>
    <Label alignment="TOP_CENTER" text="PASSWORD RESET" textFill="#000" VBox.vgrow="ALWAYS">
        <font>
            <Font name="Aparajita Bold Italic" size="30.0" />
        </font>
    </Label>
    <PasswordField fx:id="password" prefHeight="40.0" promptText="Password" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets left="10.0" right="10.0" />
        </VBox.margin>
        <font>
            <Font size="15.0" />
        </font>
    </PasswordField>
    <PasswordField fx:id="confirmPassword" layoutX="10.0" layoutY="52.0" prefHeight="40.0" promptText="Confirm Password">
        <VBox.margin>
            <Insets left="10.0" right="10.0" />
        </VBox.margin>
        <font>
            <Font size="15.0" />
        </font>
    </PasswordField>
    <Button fx:id="reset" onAction="#resetPassword" mnemonicParsing="false" prefHeight="50.0" prefWidth="150.0" text="RESET PASSWORD" VBox.vgrow="ALWAYS">
        <font>
            <Font name="Aparajita Bold Italic" size="15" />
        </font>
        <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
        </VBox.margin>
        <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
        </VBox.margin>
    </Button>
</VBox>
