<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="borderPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="700.0" style="-fx-background-color: linear-gradient(to right, #EE9CA7, #FFDDE1);" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mia.apa.RegisterController">
   <top>
      <Label text="CASHIER SECTION" textAlignment="CENTER" textFill="#000000" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets top="20.0" />
         </BorderPane.margin>
         <font>
            <Font name="System Bold Italic" size="48.0" />
         </font>
      </Label>
   </top>
   <left>
   </left>
   <center>
      <VBox alignment="TOP_CENTER" prefHeight="468.0" prefWidth="300.0" spacing="20.0" BorderPane.alignment="CENTER">
         <Label alignment="TOP_CENTER" text="REGISTER" textFill="#000" VBox.vgrow="ALWAYS">
            <VBox.margin>
               <Insets top="20.0" />
            </VBox.margin>
            <font>
               <Font name="Aparajita Bold Italic" size="30.0" />
            </font>
         </Label>
         <TextField fx:id="first_name" prefHeight="40.0" promptText="First Name" VBox.vgrow="ALWAYS">
            <VBox.margin>
               <Insets left="10.0" right="10.0" />
            </VBox.margin>
            <font>
               <Font size="15.0" />
            </font>
         </TextField>
         <TextField fx:id="last_name" layoutX="10.0" layoutY="52.0" prefHeight="40.0" promptText="Last Name">
            <VBox.margin>
               <Insets left="10.0" right="10.0" />
            </VBox.margin>
            <font>
               <Font size="15.0" />
            </font>
         </TextField>
         <TextField fx:id="id" layoutX="10.0" layoutY="77.0" prefHeight="40.0" promptText="ID Number">
            <VBox.margin>
               <Insets left="10.0" right="10.0" />
            </VBox.margin>
            <font>
               <Font size="15.0" />
            </font>
         </TextField>
         <TextField fx:id="phone" layoutX="10.0" layoutY="77.0" prefHeight="40.0" promptText="Phone Number">
            <VBox.margin>
               <Insets left="10.0" right="10.0" />
            </VBox.margin>
            <font>
               <Font size="15.0" />
            </font>
         </TextField>
         <PasswordField fx:id="password" prefHeight="40.0" promptText="Password">
            <VBox.margin>
               <Insets left="10.0" right="10.0" />
            </VBox.margin>
            <font>
               <Font size="15.0" />
            </font>
         </PasswordField>
         <PasswordField fx:id="confirm_password" prefHeight="40.0" promptText="Confirm Password">
            <VBox.margin>
               <Insets left="10.0" right="10.0" />
            </VBox.margin>
            <font>
               <Font size="15.0" />
            </font>
         </PasswordField>
         <Button mnemonicParsing="false" onAction="#register" prefHeight="50" prefWidth="150.0" text="Register">
            <font>
               <Font name="Aparajita Bold Italic" size="18.9" />
            </font>
         </Button>
         <Label onMouseClicked="#moveToLogIn" text="Already registered? Log In here">
            <font>
               <Font name="System Bold Italic" size="17.0" />
            </font>
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
         </Label>
